#include <cmath>
#include <exception>
#include <iostream>
#include <pthread.h>
#include <random>
#include <stdexcept>
#include <system_error>
#include <vector>

namespace task {
    bool isInside(double x, double y, double r);
    void* threadAdapter(void* data);
    size_t math(double r, size_t tests, size_t seed);
    double area(double r, size_t threads, size_t tests);

    struct ThreadData {
        double r = 0.0;
        size_t tests = 0;
        size_t seed = 0;
        size_t result = 0;
    };

    constexpr size_t THREADS_COUNT = 10;
}

int main() {
    double r = 0.0;
    size_t tests = 0;
    std::cin >> r >> tests;

    try {
        double res = task::area(r, task::THREADS_COUNT, tests);
        std::cout << "По Монте-Карло:" << res << '\n';
        std::cout << "По стандартной формуле" << std::acos(-1.0) * r * r << '\n';
    }

    catch (const std::exception& e) {
        std::cerr << e.what() << '\n';
        return 1;
    }
}

bool task::isInside(double x, double y, double r) {
    double dx = r - x;
    double dy = r - y;
    return dx * dx + dy * dy <= r * r;
}

size_t task::math(double r, size_t tests, size_t seed) {
    std::default_random_engine engine (seed);
    std::uniform_real_distribution< double > dist(0.0, 2.0 * r);

    size_t res = 0;
    for (size_t i = 0; i < tests; ++i) {
        double x = dist(engine);
        double y = dist(engine);
        if (isInside(x, y, r)) {
            ++res;
        }
    }
    return res;
}

void* task::threadAdapter(void* data)
{
    ThreadData* tdata = static_cast< ThreadData* >(data);
    tdata->result = math(tdata->r, tdata->tests, tdata->seed);
    return nullptr;
}

double task::area(double r, size_t threads, size_t tests) {
    if (!threads || !tests || r <= 0.0) {
        throw std::invalid_argument("Arguments must be greater than 0");
    }
}